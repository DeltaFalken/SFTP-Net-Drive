<Window x:Class="SftpNetDrive.Windows.EditProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SftpNetDrive.Localization"
        Title="{x:Static loc:Strings.WinConnectionSettings}"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8 4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#C8C8C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8 4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#C8C8C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8 4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#404040"/>
            <Setter Property="Padding" Value="0 0 0 2"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#767676"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0 12 0 6"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20 16">

        <!-- Connection Name -->
        <Label Content="{x:Static loc:Strings.LblDisplayName}"/>
        <TextBox x:Name="NameBox" Margin="0 0 0 8"/>

        <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static loc:Strings.SectionServer}"/>

        <!-- Host + Port row -->
        <Grid Margin="0 0 0 8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <Label Content="{x:Static loc:Strings.LblHost}"/>
                <TextBox x:Name="HostBox"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Label Content="{x:Static loc:Strings.LblPort}"/>
                <TextBox x:Name="PortBox" Text="22"/>
            </StackPanel>
        </Grid>

        <Label Content="{x:Static loc:Strings.LblRemotePath}"/>
        <TextBox x:Name="RemotePathBox" Text="/" Margin="0 0 0 8"/>

        <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static loc:Strings.SectionAuth}"/>

        <Label Content="{x:Static loc:Strings.LblUsername}"/>
        <TextBox x:Name="UsernameBox" Margin="0 0 0 8"/>

        <Label Content="{x:Static loc:Strings.LblAuthMethod}"/>
        <ComboBox x:Name="AuthMethodBox" Margin="0 0 0 8"
                  SelectionChanged="AuthMethod_Changed">
            <ComboBoxItem Content="{x:Static loc:Strings.AuthPassword}" Tag="Password" IsSelected="True"/>
            <ComboBoxItem Content="{x:Static loc:Strings.AuthPrivateKey}" Tag="PrivateKey"/>
        </ComboBox>

        <!-- Password panel -->
        <StackPanel x:Name="PasswordPanel">
            <Label Content="{x:Static loc:Strings.LblPassword}"/>
            <PasswordBox x:Name="PasswordBox" Margin="0 0 0 4"/>
            <TextBlock Text="{x:Static loc:Strings.PasswordHint}"
                       FontSize="10" Foreground="#A0A0A0" Margin="0 0 0 8"/>
        </StackPanel>

        <!-- Private key panel -->
        <StackPanel x:Name="KeyPanel" Visibility="Collapsed">
            <Label Content="{x:Static loc:Strings.LblKeyFile}"/>
            <Grid Margin="0 0 0 6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="KeyPathBox" IsReadOnly="True" Background="#F8F8F8"/>
                <Button Grid.Column="2" Content="{x:Static loc:Strings.BtnBrowse}" Height="30" Padding="10 4"
                        FontSize="12" Click="BrowseKey_Click"/>
            </Grid>
            <Label Content="{x:Static loc:Strings.LblPassphrase}"/>
            <PasswordBox x:Name="PassphraseBox" Margin="0 0 0 8"/>
        </StackPanel>

        <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static loc:Strings.SectionDrive}"/>

        <!-- Drive Letter + AutoMount row -->
        <Grid Margin="0 0 0 16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <Label Content="{x:Static loc:Strings.LblDriveLetter}"/>
                <ComboBox x:Name="DriveLetterBox"/>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                <CheckBox x:Name="AutoMountBox" Content="{x:Static loc:Strings.ChkAutoMount}"
                          FontSize="12" VerticalAlignment="Center" Margin="0 0 0 5"/>
            </StackPanel>
        </Grid>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static loc:Strings.BtnCancel}" Width="80" Height="30" Margin="0 0 10 0"
                    FontSize="12" Click="Cancel_Click"
                    BorderBrush="#D1D1D1" Background="White">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="10 4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="{x:Static loc:Strings.BtnSave}" Width="80" Height="30" FontSize="12"
                    Click="Save_Click" IsDefault="True">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#0067C0" CornerRadius="4" Padding="10 4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0078D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Button.Foreground>White</Button.Foreground>
            </Button>
        </StackPanel>

    </StackPanel>
</Window>
